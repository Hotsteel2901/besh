# Regression: brace expansion must (a) stay within its buffer and
# (b) recurse into braces that follow a range.
#
# Two separate defects lived here, both surfaced by ASan:
#   * `out[nout] = NULL` wrote one element past the end whenever the number
#     of products exactly filled the array ({a,b}{1,2}, pre{1..2}post);
#   * the {lo..hi} branch emitted its products without recursing, so a
#     brace to its right survived literally ({1..5}{a,b} printed
#     "1{a,b} 2{a,b} ..." instead of the full cross product).

echo {1..3}
echo {a..c}
echo {a,b}{1,2}
echo pre{1..2}post
echo {1..5}{a,b}
echo x{1..2}{3..4}y
echo {a,b}{c,d}{e,f}
echo {1..2}{3..4}{5..6}
echo pre{a,b}mid{1,2}post
echo no-braces-here
echo {}
echo {single}
